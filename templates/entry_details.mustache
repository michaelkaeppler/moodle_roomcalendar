{{!
    @template mod_roomcalendar/entry_details

    Body of the entry details modal. The description (format_text) and room (format_string) are already
    filtered HTML, as is the category (format_string); all other values are plain text.

    Example context (json):
    {
        "name": "Team meeting", "time": "Wednesday, 14 October 2026, 10:00 – 11:00",
        "room": "Room A", "color": "blue", "category": "Lessons", "creator": "Jane Doe", "inseries": true,
        "contactname": "John Smith", "contactemail": "john.smith@example.com",
        "description": "<p>Weekly sync</p>"
    }
}}
<dl class="mod-roomcalendar-details">
    <dt>{{#str}}time, mod_roomcalendar{{/str}}</dt>
    <dd>{{time}}</dd>
    <dt>{{#str}}room, mod_roomcalendar{{/str}}</dt>
    <dd>{{#room}}<span class="mod-roomcalendar-swatch rc-color-{{color}}"></span>{{{room}}}{{/room}}{{^room}}{{#str}}noroom, mod_roomcalendar{{/str}}{{/room}}</dd>
    {{#category}}
    <dt>{{#str}}category, mod_roomcalendar{{/str}}</dt>
    <dd>{{{category}}}</dd>
    {{/category}}
    {{#contactname}}
    <dt>{{#str}}contactperson, mod_roomcalendar{{/str}}</dt>
    <dd>{{contactname}}{{#contactemail}} · <a href="mailto:{{contactemail}}">{{contactemail}}</a>{{/contactemail}}</dd>
    {{/contactname}}
    {{#creator}}
    <dt>{{#str}}createdby, mod_roomcalendar{{/str}}</dt>
    <dd>{{creator}}</dd>
    {{/creator}}
    {{#inseries}}
    <dt>{{#str}}repeat, mod_roomcalendar{{/str}}</dt>
    <dd>{{#str}}partofseries, mod_roomcalendar{{/str}}</dd>
    {{/inseries}}
</dl>
{{#description}}
<div class="mod-roomcalendar-description">{{{description}}}</div>
{{/description}}
