{{!
    @template mod_roomcalendar/grid

    Time grid used by the day view (one column per room) and the week view (one column per day).

    Example context (json):
    {
        "grid": {
            "hourcount": 2, "columncount": 1,
            "hours": [{"label": "08:00"}, {"label": "09:00"}],
            "columns": [{
                "title": "Mon", "subtitle": "12 October", "url": "#", "istoday": true, "color": "",
                "daystart": 0, "slotroomid": 0, "canaddallday": true,
                "alldayentries": [],
                "entries": [{"id": 1, "name": "Meeting", "time": "08:00–09:00", "color": "blue",
                             "style": "top:0%;height:50%;left:0%;width:100%;"}],
                "slots": [{"start": 0, "label": "Monday, 12 October 2026, 08:00"}]
            }]
        }
    }
}}
<div class="mod-roomcalendar-gridwrap">
<div class="mod-roomcalendar-grid{{#isday}} isday{{/isday}}" style="--rc-hours: {{grid.hourcount}}; --rc-cols: {{grid.columncount}};">
    <div class="mod-roomcalendar-corner"></div>
    {{#grid.columns}}
    <div class="mod-roomcalendar-colhead{{#istoday}} today{{/istoday}}">
        {{#color}}<span class="mod-roomcalendar-swatch rc-color-{{color}}"></span>{{/color}}
        {{#url}}<a href="{{url}}">{{{title}}}</a>{{/url}}{{^url}}{{{title}}}{{/url}}
        {{#subtitle}}<span class="mod-roomcalendar-colsub">{{subtitle}}</span>{{/subtitle}}
    </div>
    {{/grid.columns}}

    <div class="mod-roomcalendar-rowlabel">{{#str}}allday, mod_roomcalendar{{/str}}</div>
    {{#grid.columns}}
    <div class="mod-roomcalendar-alldaycell{{#istoday}} today{{/istoday}}">
        {{#alldayentries}}{{> mod_roomcalendar/entry_chip}}{{/alldayentries}}
        {{#canaddallday}}
        <button type="button" class="mod-roomcalendar-alldayadd" data-action="add-entry" data-start="{{daystart}}"
                data-roomid="{{slotroomid}}" data-allday="1" tabindex="-1" aria-label="{{#str}}addalldayentry, mod_roomcalendar{{/str}}"></button>
        {{/canaddallday}}
    </div>
    {{/grid.columns}}

    <div class="mod-roomcalendar-hours" aria-hidden="true">
        {{#grid.hours}}<div class="mod-roomcalendar-hour">{{label}}</div>{{/grid.hours}}
    </div>
    {{#grid.columns}}
    <div class="mod-roomcalendar-col{{#istoday}} today{{/istoday}}">
        {{#slots}}
        <button type="button" class="mod-roomcalendar-slot" data-action="add-entry" data-start="{{start}}"
                data-roomid="{{slotroomid}}" tabindex="-1" aria-label="{{#str}}addentryon, mod_roomcalendar, {{label}}{{/str}}"></button>
        {{/slots}}
        <div class="mod-roomcalendar-colentries">
            {{#entries}}{{> mod_roomcalendar/entry_chip}}{{/entries}}
        </div>
    </div>
    {{/grid.columns}}
</div>
</div>
