{{!
    @template mod_roomcalendar/month

    Month table. Used inside mod_roomcalendar/calendar (canaddhere and addroomid come from there).

    Example context (json):
    {
        "canaddhere": true, "addroomid": 0, "title": "October 2026",
        "month": {
            "weekdays": [{"name": "Mon"}, {"name": "Tue"}],
            "weeks": [{"days": [
                {"daynum": 1, "label": "Monday, 1 October 2026", "dayurl": "#", "istoday": false, "othermonth": false,
                 "addstart": 0, "more": "", "entries": [{"id": 1, "name": "Meeting", "time": "10:00–11:00", "color": "blue"}]}
            ]}]
        }
    }
}}
<div class="mod-roomcalendar-monthwrap">
<table class="mod-roomcalendar-month">
    <caption class="mod-roomcalendar-sr-only">{{title}}</caption>
    <thead>
        <tr>
            {{#month.weekdays}}<th scope="col">{{name}}</th>{{/month.weekdays}}
        </tr>
    </thead>
    <tbody>
        {{#month.weeks}}
        <tr>
            {{#days}}
            <td class="{{#othermonth}}othermonth{{/othermonth}} {{#istoday}}today{{/istoday}}">
                <div class="mod-roomcalendar-dayhead">
                    <a class="mod-roomcalendar-daynum" href="{{dayurl}}" title="{{label}}" {{#istoday}}aria-current="date"{{/istoday}}>
                        <span aria-hidden="true">{{daynum}}</span><span class="mod-roomcalendar-sr-only">{{label}}</span>
                    </a>
                    {{#canaddhere}}
                    <button type="button" class="mod-roomcalendar-dayadd" data-action="add-entry" data-start="{{addstart}}"
                            data-roomid="{{addroomid}}" title="{{#str}}addentryon, mod_roomcalendar, {{label}}{{/str}}">
                        {{#pix}}t/add, core, {{#str}}addentryon, mod_roomcalendar, {{label}}{{/str}}{{/pix}}
                    </button>
                    {{/canaddhere}}
                </div>
                <ul class="mod-roomcalendar-daylist">
                    {{#entries}}<li>{{> mod_roomcalendar/entry_chip}}</li>{{/entries}}
                </ul>
                {{#more}}<a class="mod-roomcalendar-more" href="{{dayurl}}">{{more}}</a>{{/more}}
            </td>
            {{/days}}
        </tr>
        {{/month.weeks}}
    </tbody>
</table>
</div>
