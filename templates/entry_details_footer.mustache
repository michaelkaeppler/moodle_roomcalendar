{{!
    @template mod_roomcalendar/entry_details_footer

    Footer buttons of the entry details modal.

    Example context (json):
    {
        "canedit": true, "inseries": true, "dayurl": "#"
    }
}}
<a class="btn btn-outline-secondary me-auto" href="{{dayurl}}">{{#str}}openday, mod_roomcalendar{{/str}}</a>
{{#canedit}}
{{#inseries}}
<button type="button" class="btn btn-outline-danger" data-action="delete-series">{{#str}}deleteseries, mod_roomcalendar{{/str}}</button>
{{/inseries}}
<button type="button" class="btn btn-danger" data-action="delete">{{#str}}delete{{/str}}</button>
<button type="button" class="btn btn-primary" data-action="edit">{{#str}}edit{{/str}}</button>
{{/canedit}}
