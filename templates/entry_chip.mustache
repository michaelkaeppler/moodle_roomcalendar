{{!
    @template mod_roomcalendar/entry_chip

    A single entry inside a calendar cell. Clicking it opens the details.

    Example context (json):
    {
        "id": 1, "name": "Team meeting", "contact": "Jane Doe", "time": "10:00–11:00", "room": "Room A", "color": "blue",
        "style": "top:10%;height:5%;left:0%;width:100%;", "continuesbefore": false, "continuesafter": false
    }
}}
<button type="button" class="mod-roomcalendar-entry rc-color-{{color}}{{#continuesbefore}} continuesbefore{{/continuesbefore}}{{#continuesafter}} continuesafter{{/continuesafter}}"
        data-action="show-entry" data-entryid="{{id}}" {{#style}}style="{{style}}"{{/style}}>
    <span class="mod-roomcalendar-entry-time">{{time}}</span>
    <span class="mod-roomcalendar-entry-name">{{{name}}}</span>
    {{#contact}}<span class="mod-roomcalendar-entry-contact">({{contact}})</span>{{/contact}}
    {{#room}}<span class="mod-roomcalendar-entry-room">{{{room}}}</span>{{/room}}
</button>
